# ATLAS mode: paper (default) | live
ATLAS_MODE=paper

# Paper trading starting balance (USDT)
ATLAS_START_BALANCE=1000

# Quote currency
ATLAS_QUOTE=USDT

# Autonomous loop cycle interval (minutes)
ATLAS_INTERVAL_MINUTES=10

# Candlestick timeframes used for analysis
ATLAS_TREND_TIMEFRAME=1h
ATLAS_ENTRY_TIMEFRAME=15m
ATLAS_BACKTEST_TIMEFRAME=1h

# Watchlist (comma separated)
ATLAS_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT

# Risk parameters (hard constraints, do not exceed)
ATLAS_RISK_PER_TRADE=0.02
ATLAS_MAX_POSITION_PCT=0.08
ATLAS_MAX_POSITIONS=4
ATLAS_STOP_PCT=0.03
ATLAS_TAKE_PROFIT_RR=1.5
ATLAS_TRAIL_STOP=true
ATLAS_TRAIL_PCT=0.02
ATLAS_DRAWDOWN_HALT=0.10
ATLAS_DAILY_LOSS_LIMIT=0.03
ATLAS_CASH_RESERVE=0.20
ATLAS_COOLDOWN_MINUTES=30
ATLAS_ALLOW_SHORT=false
ATLAS_MAX_HOLD_BARS=96

# Conviction threshold to enter (6-7 small, 8-9 standard, 10 high)
ATLAS_MIN_CONVICTION=7

# Optional sentiment factor (offline naive RSS scoring, no API key).
# Feed content is treated as UNTRUSTED data: it can only nudge the score a
# bounded amount and can never change risk limits, modes, or issue instructions.
ATLAS_SENTIMENT_ENABLED=false

# Execution costs and market-quality gates
ATLAS_FEE_RATE=0.001
ATLAS_SLIPPAGE=0.0005
ATLAS_MAX_SPREAD_PCT=1.0
ATLAS_MIN_VOLUME_24H=0.0

# Margin policy for live mode (1 = no leverage). Enforced per entry.
ATLAS_MAX_LEVERAGE=1

# Stale-market-data guard: skip a symbol if its latest candle is older than
# timeframe * multiplier. Disable only in backtests (handled automatically).
ATLAS_STALE_DATA_MULTIPLIER=3
ATLAS_CHECK_STALE=true

# Operator escalation: notify CRITICAL when a single losing trade costs more
# than this fraction of current equity.
ATLAS_ESCALATE_LOSS_PCT=0.015

# Quantitative operating-mode thresholds (measurable, not LLM confidence):
# defensive when drawdown >= threshold OR today's loss >= day-loss threshold.
# Modes only scale the position cap and raise the conviction floor; the
# per-trade risk budget (RISK_PER_TRADE) is never exceeded in any mode.
ATLAS_AGGRESSIVE_ENABLED=false
ATLAS_DEFENSIVE_DRAWDOWN=0.03
ATLAS_DAY_LOSS_DEFENSIVE=0.015
ATLAS_DEFENSIVE_MIN_CONVICTION=8
ATLAS_AGGRESSIVE_SIZE_FACTOR=1.2
ATLAS_DEFENSIVE_SIZE_FACTOR=0.6

# Kill switch: `python -m engine kill` writes data/kill. The engine closes all
# positions and halts on the next cycle; `python -m engine kill --off` resumes.
# No remote code path can raise limits or change modes based on market data.

# Live trading credentials (only used when ATLAS_MODE=live)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# Operator notifications (optional)
ATLAS_NOTIFY_TELEGRAM_BOT_TOKEN=
ATLAS_NOTIFY_TELEGRAM_CHAT_ID=

# Dashboard admin secret for license generation
ATLAS_LICENSE_SECRET=change-me-please
ATLAS_ADMIN_TOKEN=change-me-please
DASHBOARD_PORT=4173

# Product licensing: set REQUIRED=true in production to block trading on expired keys.
# Key can be set via ATLAS_LICENSE_KEY or by writing it to data/license.key
ATLAS_LICENSE_KEY=
ATLAS_LICENSE_REQUIRED=false